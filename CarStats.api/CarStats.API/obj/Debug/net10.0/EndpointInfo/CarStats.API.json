  "components": {
    "schemas": {
      "AppUser": {
        "required": [
          "email",
          "fullName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "fullName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string"
          },
          "passwordHash": {
            "type": "string",
            "nullable": true
          },
          "newPassword": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "totalFaultsLogged": {
            "type": "integer",
            "format": "int32"
          },
          "isPremiumMember": {
            "type": "boolean"
          },
          "vehicles": {
            "type": "array",
