            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DiagnosticCode": {
        "required": [
          "description",
          "errorCode",
          "humanTitle",
          "severity"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "errorCode": {
            "maxLength": 10,
            "minLength": 1,
            "type": "string"
          },
          "humanTitle": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/SeverityLevel"
          },
          "actionRequired": {
            "type": "string",
            "nullable": true
          },
          "estimatedCostMin": {
            "type": "number",
            "format": "double"
          },
          "estimatedCostMax": {
            "type": "number",
            "format": "double"
          },
          "appUserId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "user": {
            "$ref": "#/components/schemas/AppUser"
          }
        },
        "additionalProperties": false
      },
      "MechanicShop": {
        "required": [
          "address",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "address": {
            "minLength": 1,
            "type": "string"
          },
          "phoneNumber": {
            "type": "string",
            "format": "tel",
            "nullable": true
          },
          "specialty": {
            "type": "string",
            "nullable": true
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "ReportDtcRequest": {
        "type": "object",
        "properties": {
          "rawCode": {
            "type": "string",
            "nullable": true
          },
          "userId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "vehicleId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SeverityLevel": {
        "enum": [
          1,
          2,
          3
        ],
        "type": "integer",
        "format": "int32"
      },
      "UserRole": {
        "enum": [
          1,
          2,
          3
        ],
        "type": "integer",
        "format": "int32"
      },
      "Vehicle": {
        "required": [
          "make",
          "model"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "make": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "model": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "year": {
            "type": "integer",
            "format": "int32"
          },
          "licensePlate": {
            "maxLength": 20,
            "type": "string",
            "nullable": true
          },
          "averageFuelConsumption": {
            "type": "number",
            "format": "double"
          },
          "appUserId": {
            "type": "integer",
            "format": "int32"
          },
          "user": {
            "$ref": "#/components/schemas/AppUser"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VehicleEvent"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "VehicleEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "rawErrorCode": {
            "type": "string",
            "nullable": true
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "isAcknowledged": {
            "type": "boolean"
          },
          "vehicleId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "vehicle": {
            "$ref": "#/components/schemas/Vehicle"
          },
          "appUserId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "user": {
            "$ref": "#/components/schemas/AppUser"
          }
        },
        "additionalProperties": false
      }
