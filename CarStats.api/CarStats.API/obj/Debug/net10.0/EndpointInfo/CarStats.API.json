{
  "openapi": "3.0.4",
  "info": {
    "title": "CarStats.API",
    "version": "1.0"
  },
  "paths": {
    "/api/Dtc": {
      "get": {
        "tags": [
          "Dtc"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DiagnosticCode"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DiagnosticCode"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DiagnosticCode"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Dtc"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiagnosticCode"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/DiagnosticCode"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/DiagnosticCode"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/DiagnosticCode"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiagnosticCode"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiagnosticCode"
                }
              }
            }
          }
        }
      }
    },
    "/api/Mobile/report-dtc": {
      "post": {
        "tags": [
          "Mobile"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "string"
              }
            },
            "text/json": {
              "schema": {
                "type": "string"
              }
            },
            "application/*+json": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DiagnosticCode": {
        "required": [
          "description",
          "errorCode",
          "humanTitle",
          "severity"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "errorCode": {
            "maxLength": 10,
            "minLength": 1,
            "type": "string"
          },
          "humanTitle": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/SeverityLevel"
          },
          "actionRequired": {
            "type": "string",
            "nullable": true
          },
          "estimatedCostMin": {
            "type": "number",
            "format": "double"
          },
          "estimatedCostMax": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "SeverityLevel": {
        "enum": [
          1,
          2,
          3
        ],
        "type": "integer",
        "format": "int32"
      }
    }
  },
  "tags": [
    {
      "name": "Dtc"
    },
    {
      "name": "Mobile"
    }
  ]
}