# CarStats Mobile — environment variable template
# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.
#
# Get a free Gemini key at: https://aistudio.google.com

EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_key_here

# NOTE: the trip planner's Google Maps calls go through the API's
# /navigation proxy — the key lives server-side (GoogleMaps:ApiKey in the
# API's appsettings.Production.json), not in this file.
