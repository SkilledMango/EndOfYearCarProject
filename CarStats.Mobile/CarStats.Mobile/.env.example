# CarStats Mobile — environment variable template
# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.
#
# Get a free Gemini key at: https://aistudio.google.com

EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_key_here

# Google Maps Platform key (Directions + Places APIs) for the trip planner
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_key_here
